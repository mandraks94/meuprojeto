{
  "manifest_version": 3,
  "name": "IG Tools Pro",
  "version": "1.1.0",
  "description": "Ferramentas avançadas para Instagram: Download de mídias, Histórias, Destaques, Gestão de Seguidores, Bloqueados e Modo Anônimo.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "IG Tools Pro",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "alarms",
    "notifications",
    "cookies",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://*.googleapis.com/*",
    "https://accounts.google.com/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": [
        "src/core/config.js",
        "src/core/i18n.js",
        "src/network/http-client.js",
        "src/network/gdrive-api.js",
        "src/core/storage.js",
        "src/core/dom-utils.js",
        "src/features/profile-interactions.js",
        "src/features/blocked-accounts.js",
        "src/features/hide-story.js",
        "src/features/muted-accounts.js",
        "src/features/close-friends.js",
        "src/features/categories.js",
        "src/features/reels.js",
        "src/features/bulk-actions.js",
        "src/features/settings.js",
        "src/features/shortcuts.js",
        "src/features/voice-control.js",
        "src/features/media-downloader.js",
        "src/features/followers-analysis.js",
        "instagram.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["*://*.instagram.com/*"]
    }
  ]
}
